#!/bin/sh
# gadunix-install
# Interactive installer for Gadunix
# Designed to run from the live ISO environment.
# Based on Alpine's setup-* scripts pattern.

set -e

DISTRO_NAME="Gadunix"
DISTRO_VERSION="0.1.0"
ALPINE_MIRROR="https://dl-cdn.alpinelinux.org/alpine/edge"
SWAP_SIZE="2GiB"

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

msg()  { printf "${BOLD}${BLUE}==> ${RESET}${BOLD}%s${RESET}\n" "$*"; }
ok()   { printf "${GREEN}[OK]${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}[WARN]${RESET} %s\n" "$*"; }
die()  { printf "${RED}[ERROR]${RESET} %s\n" "$*" >&2; exit 1; }

confirm() {
	printf "%s [y/N]: " "$1"
	read -r ans
	case "$ans" in [yY]*) return 0;; *) return 1;; esac
}

MNTDIR="/mnt/gadunix"

# Always try to unmount on exit so a failed install never leaves a half-mounted
# system behind (or the target disk busy).
cleanup() {
	umount -R "$MNTDIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ── Banner ────────────────────────────────────────────────────────────────────
clear
printf "${BOLD}"
cat << 'EOF'
  ┌───────────────────────────────────────┐
  │          Gadunix Installer            │
  └───────────────────────────────────────┘
EOF
printf "${RESET}\n"
warn "This will ERASE the selected disk. Make sure you have backups."
printf "\n"

# ── Check root ────────────────────────────────────────────────────────────────
[ "$(id -u)" -eq 0 ] || die "Installer must be run as root."

# ── Detect firmware ───────────────────────────────────────────────────────────
if [ -d /sys/firmware/efi ]; then
	BOOT_MODE="efi"
	msg "Detected UEFI firmware."
else
	BOOT_MODE="bios"
	msg "Detected BIOS firmware."
fi

# ── Disk selection ────────────────────────────────────────────────────────────
msg "Available disks:"
lsblk -d -o NAME,SIZE,TYPE,MODEL | grep disk
printf "\n"
printf "Enter target disk (e.g. sda, nvme0n1, vda): "
read -r DISK
DISK="/dev/${DISK}"
[ -b "$DISK" ] || die "Device $DISK not found."

printf "\n"
warn "ALL DATA ON $DISK WILL BE DESTROYED."
confirm "Continue?" || { msg "Aborted."; exit 0; }

# ── Hostname ──────────────────────────────────────────────────────────────────
printf "\nHostname [gadunix]: "
read -r HOSTNAME
HOSTNAME="${HOSTNAME:-gadunix}"

# ── Timezone ──────────────────────────────────────────────────────────────────
printf "Timezone [UTC]: "
read -r TIMEZONE
TIMEZONE="${TIMEZONE:-UTC}"

# ── Root password ─────────────────────────────────────────────────────────────
printf "Root password: "
stty -echo; read -r ROOT_PASS; stty echo; printf "\n"
printf "Confirm password: "
stty -echo; read -r ROOT_PASS2; stty echo; printf "\n"
[ "$ROOT_PASS" = "$ROOT_PASS2" ] || die "Passwords do not match."

# ── Partition ─────────────────────────────────────────────────────────────────
msg "Partitioning $DISK (GPT: boot + swap + root)..."
case "$BOOT_MODE" in
	efi)
		parted -s "$DISK" \
			mklabel gpt \
			mkpart ESP fat32 1MiB 513MiB \
			set 1 esp on \
			mkpart swap linux-swap 513MiB 2561MiB \
			mkpart root ext4 2561MiB 100%
		;;
	bios)
		parted -s "$DISK" \
			mklabel gpt \
			mkpart grub 1MiB 2MiB \
			set 1 bios_grub on \
			mkpart swap linux-swap 2MiB 2050MiB \
			mkpart root ext4 2050MiB 100%
		;;
esac

# Partition paths (handle nvme vs sda naming)
case "$DISK" in
	*nvme*|*mmcblk*)
		BOOT_PART="${DISK}p1"; SWAP_PART="${DISK}p2"; ROOT_PART="${DISK}p3" ;;
	*)
		BOOT_PART="${DISK}1";  SWAP_PART="${DISK}2";  ROOT_PART="${DISK}3"  ;;
esac

# ── Format ────────────────────────────────────────────────────────────────────
msg "Formatting partitions..."
if [ "$BOOT_MODE" = "efi" ]; then
	mkfs.fat -F32 -n EFI "$BOOT_PART"
fi
mkswap "$SWAP_PART"
mkfs.ext4 -L gadunix "$ROOT_PART"

# ── Mount ─────────────────────────────────────────────────────────────────────
msg "Mounting..."
mkdir -p "$MNTDIR"
mount "$ROOT_PART" "$MNTDIR"
if [ "$BOOT_MODE" = "efi" ]; then
	mkdir -p "$MNTDIR/boot/efi"
	mount "$BOOT_PART" "$MNTDIR/boot/efi"
fi

# ── Base install ──────────────────────────────────────────────────────────────
msg "Installing base system (this will take a few minutes)..."
mkdir -p "$MNTDIR/etc/apk"

# Write APK repos
cat > "$MNTDIR/etc/apk/repositories" << EOF
${ALPINE_MIRROR}/main
${ALPINE_MIRROR}/community
EOF

apk add --root "$MNTDIR" --initdb --no-cache \
	alpine-base \
	linux-lts \
	bash \
	openssl \
	ca-certificates \
	curl \
	openssh \
	e2fsprogs \
	util-linux \
	dhcpcd \
	iproute2 \
	nano \
	htop \
	git \
	python3

if [ "$BOOT_MODE" = "efi" ]; then
	apk add --root "$MNTDIR" --no-cache grub-efi efibootmgr
else
	apk add --root "$MNTDIR" --no-cache grub-bios
fi

ok "Base system installed."

# ── Configure ─────────────────────────────────────────────────────────────────
msg "Configuring system..."

# fstab
ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")
SWAP_UUID=$(blkid -s UUID -o value "$SWAP_PART")

{
	echo "UUID=$ROOT_UUID  /      ext4  defaults,noatime  0 1"
	echo "UUID=$SWAP_UUID  none   swap  sw                0 0"
	if [ "$BOOT_MODE" = "efi" ]; then
		BOOT_UUID=$(blkid -s UUID -o value "$BOOT_PART")
		echo "UUID=$BOOT_UUID  /boot/efi  vfat  umask=0077  0 2"
	fi
} > "$MNTDIR/etc/fstab"

# hostname
echo "$HOSTNAME" > "$MNTDIR/etc/hostname"

# timezone
ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MNTDIR/etc/localtime"

# root password (heredoc keeps it out of the process list)
chroot "$MNTDIR" chpasswd << EOF
root:${ROOT_PASS}
EOF

# distro identity
cat > "$MNTDIR/etc/os-release" << EOF
NAME="$DISTRO_NAME"
VERSION="$DISTRO_VERSION"
ID=gadunix
ID_LIKE=alpine
PRETTY_NAME="$DISTRO_NAME $DISTRO_VERSION"
EOF

cat > "$MNTDIR/etc/gadunix-release" << EOF
$DISTRO_NAME $DISTRO_VERSION
Built on Alpine Linux
EOF

# ── Bootloader ────────────────────────────────────────────────────────────────
msg "Installing bootloader..."
if [ "$BOOT_MODE" = "efi" ]; then
	# Expose EFI variables to the chroot so grub can register its boot entry
	mkdir -p "$MNTDIR/sys/firmware/efi/efivars"
	mount -o bind /sys/firmware/efi/efivars "$MNTDIR/sys/firmware/efi/efivars"
	chroot "$MNTDIR" grub-install --target=x86_64-efi \
		--efi-directory=/boot/efi \
		--bootloader-id=Gadunix
else
	chroot "$MNTDIR" grub-install --target=i386-pc "$DISK"
fi

chroot "$MNTDIR" grub-mkconfig -o /boot/grub/grub.cfg

# ── Services ──────────────────────────────────────────────────────────────────
msg "Enabling services..."
chroot "$MNTDIR" rc-update add networking boot
chroot "$MNTDIR" rc-update add dhcpcd default
chroot "$MNTDIR" rc-update add sshd default

# ── Done ──────────────────────────────────────────────────────────────────────
umount -R "$MNTDIR"
trap - EXIT INT TERM

printf "\n"
ok "$DISTRO_NAME $DISTRO_VERSION installed successfully to $DISK."
ok "Remove installation media and reboot."
printf "\n"
